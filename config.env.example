# MLHK Monitor Configuration (.env)
# Pas onderstaande waarden aan voor jouw eigen setup

# Algemeen
SERVER_NAME=SMURF-SERVER
MONITOR_TITLE=MLHK SERVER MONITOR
REFRESH_INTERVAL=3.0

# Server 2: Home Assistant Integratie
ENABLE_HA=true
HA_HOST=192.168.2.56
HA_PORT=8123
# Genereer een Long-Lived Access Token in Home Assistant (Profiel -> Beveiliging -> Tokens)
HA_TOKEN=vul_hier_jouw_homeassistant_token_in

# Server 3: Remote Raspberry Pi / Media Node (Plex, Jellyfin, Opslag)
ENABLE_REMOTE_NODE=true
REMOTE_NODE_HOST=192.168.2.25
REMOTE_NODE_USER=molhoek

# Weer & Live Neerslagradar
# Standaard: 's-Hertogenbosch (51.6978, 5.3037)
WEATHER_LAT=51.6978
WEATHER_LON=5.3037
WEATHER_CITY='S-HERTOGENBOSCH

# Proxmox VE API Token (Optioneel voor VM / Container statistieken)
PVE_TOKEN_FILE=/home/mlhk-monitor/.config/mlhk-monitor/pve-token.json
PVE_HOST=127.0.0.1
PVE_PORT=8006
